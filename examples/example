library(readr)
library(dplyr)

source("IBIS/github_code/calculate_ibis.R")
file.name = "IBIS/ebd_IL_May-2026.txt"

ebd <- read_tsv(
  file.name,
  show_col_types = FALSE,
  guess_max = 100000
)

# Example: Global Big Day in Israel, using common names
ibis_results <- calculate_ibis(
  ebd = ebd,
  date = "2026-05-09",
  taxon_var = "COMMON NAME",
  region = "all",
  species_only = TRUE
)

# Observer-level scores
ibis_by_observer <- ibis_results$ibis_by_observer

# Long-format list of observer-taxon contributions
observer_marginal_taxa <- ibis_results$observer_marginal_taxa

# eBird data actually used after filtering
filtered_ebd <- ibis_results$filtered_ebd

# Print only observers with positive IBIS
ibis_by_observer %>%
  filter(IBIS > 0) %>%
  print(n = Inf)

# Print all observers
print(ibis_by_observer, n = Inf)

# Save outputs
write_csv(ibis_by_observer, "IBIS/ibis_by_observer_2026-04-09.csv")
write_csv(observer_marginal_taxa, "IBIS/observer_marginal_taxa_2026-04-09.csv")
